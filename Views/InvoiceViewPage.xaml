<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Essensausgleich.Views.InvoiceViewPage"
             xmlns:viewmodel="clr-namespace:Essensausgleich.ViewModel"
             xmlns:local="clr-namespace:Essensausgleich"
             xmlns:tools="clr-namespace:Essensausgleich.Tools"
             xmlns:data="clr-namespace:Essensausgleich.Data"
             xmlns:views="clr-namespace:Essensausgleich.Views"
             x:DataType="viewmodel:Anwendung"
             Title="InvoiceViewPage">
    <ContentPage.ToolbarItems >
        <ToolbarItem Text="Delete this Project"
                         Command="{Binding DeleteCurrentProjectCommand}"/>
    </ContentPage.ToolbarItems>
    <Grid 
        RowDefinitions="50,*,*"
        ColumnDefinitions="*">
        <!--Header-->
        <VerticalStackLayout
            Grid.Row="0">
            <Label
            Text="InvoiceViewPage"/>
        </VerticalStackLayout>
        <!--Invoices in AppDataDirectory-->
        <VerticalStackLayout
            Grid.Row="1">
            <Label 
             Text="Invoices"
             VerticalOptions="Center" 
             HorizontalOptions="Center"/>
            <!--Datatrigger to IsEnable when the New Invoice Formular appears-->
            <CollectionView 
             ItemsSource="{Binding CurrentInvoices.InvoiceList}">
                <CollectionView.ItemTemplate>
                    <DataTemplate 
                    x:DataType="data:Invoice">
                        <Grid>
                            <Border
                                Style="{StaticResource Key=ItemBorder}">
                                <HorizontalStackLayout>
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:Anwendung}},Path=LoadSelectedInvoiceToCurrentCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </HorizontalStackLayout.GestureRecognizers>
                                    <VerticalStackLayout>
                                        <Label Text="{Binding DateTimeCreation,StringFormat='&#x270E;{0:dd.MM.yy, HH:mm} | '}"/>
                                        <Label Text="{Binding DateTimeChanged,StringFormat='&#x21BB;{0:dd.MM.yy, HH:mm} | '}"/>
                                    </VerticalStackLayout>
                                    <Label
                                        Text="{Binding InvoiceName}"
                                        FontSize="Medium"/>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button
                Text="Add new Invoice"
                Command="{Binding ShowInvoiceFormularCommand}"/>
            <views:NewInvoiceView
                IsVisible="{Binding IsInputFormularVisible}"
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Background="Aqua"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Essensausgleich.Views.NewInvoiceView"
             xmlns:viewmodel="clr-namespace:Essensausgleich.ViewModel" 
             xmlns:local="clr-namespace:Essensausgleich"
             xmlns:tools="clr-namespace:Essensausgleich.Tools"
             x:DataType="viewmodel:Anwendung">
    <VerticalStackLayout>
        <Entry Placeholder="Invoice Name"
               MinimumHeightRequest="48"
               Text="{Binding InvoiceToCreate.InvoiceName,Mode=TwoWay}"/>
        <Entry Placeholder="First Username"
               MinimumHeightRequest="48"
               Text="{Binding InvoiceToCreate.Inhabitants[0].Name,Mode=TwoWay}"/>
        <Entry Placeholder="Secound Username"
               MinimumHeightRequest="48"
               Text="{Binding InvoiceToCreate.Inhabitants[1].Name,Mode=TwoWay}"/>
        <Button 
            Text="Create new Invoice"
            MinimumHeightRequest="48"
            Command="{Binding NewInvoiceCommand}"/>
    </VerticalStackLayout>
</ContentView>
